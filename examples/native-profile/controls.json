{
  "version": "1",
  "id": "profile",
  "loader": "load-profile",
  "root": {
    "id": "profile-region",
    "type": "region",
    "props": {
      "label": "Profile"
    },
    "children": [
      {
        "id": "profile-layout",
        "type": "stack",
        "props": {
          "gap": "md",
          "direction": "column"
        },
        "children": [
          {
            "id": "profile-title",
            "type": "text",
            "props": {
              "text": "Your profile"
            }
          },
          {
            "id": "demo-notice",
            "type": "notice",
            "props": {
              "title": "Local demo only",
              "text": "Your profile lives in a temporary local session. This is not production authentication or storage."
            }
          },
          {
            "id": "profile-form",
            "type": "form",
            "props": {
              "label": "Edit profile"
            },
            "event": {
              "on": "submit",
              "action": "save-profile",
              "target": "profile-region"
            },
            "children": [
              {
                "id": "display-name",
                "type": "input",
                "props": {
                  "name": "displayName",
                  "label": "Display name",
                  "type": "text",
                  "placeholder": "Ada Lovelace",
                  "required": true
                },
                "bindings": {
                  "value": "/@data/displayName"
                }
              },
              {
                "id": "company",
                "type": "input",
                "props": {
                  "name": "company",
                  "label": "Company",
                  "type": "text",
                  "placeholder": "Optional company"
                },
                "bindings": {
                  "value": "/@data/company"
                }
              },
              {
                "id": "notifications",
                "type": "switch",
                "props": {
                  "name": "notifications",
                  "label": "Enable notifications"
                },
                "bindings": {
                  "checked": "/@data/notifications"
                }
              },
              {
                "id": "digest-consent",
                "type": "checkbox",
                "props": {
                  "name": "digestConsent",
                  "label": "Receive a weekly digest"
                },
                "bindings": {
                  "checked": "/@data/digestConsent"
                }
              },
              {
                "id": "color-theme",
                "type": "select",
                "props": {
                  "name": "colorTheme",
                  "label": "Color theme",
                  "options": [
                    {
                      "value": "system",
                      "label": "System"
                    },
                    {
                      "value": "light",
                      "label": "Light"
                    },
                    {
                      "value": "dark",
                      "label": "Dark"
                    }
                  ]
                },
                "bindings": {
                  "value": "/@data/colorTheme"
                }
              },
              {
                "id": "save-profile",
                "type": "button",
                "props": {
                  "type": "submit",
                  "label": "Save profile",
                  "variant": "primary"
                }
              }
            ]
          },
          {
            "id": "profile-error",
            "type": "notice",
            "props": {
              "title": "Check your display name",
              "urgent": true
            },
            "bindings": {
              "text": "/@data/error"
            },
            "when": {
              "op": "ne",
              "path": "/@data/error",
              "value": ""
            }
          },
          {
            "id": "profile-status",
            "type": "text",
            "bindings": {
              "text": "/@data/message"
            },
            "when": {
              "op": "ne",
              "path": "/@data/message",
              "value": ""
            }
          }
        ]
      }
    ]
  }
}
